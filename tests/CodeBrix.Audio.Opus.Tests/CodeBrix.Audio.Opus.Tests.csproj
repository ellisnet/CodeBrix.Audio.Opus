<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Audio.Opus\CodeBrix.Audio.Opus.csproj" />
  </ItemGroup>

  <!--
    Audio fixtures live under tests/Assets/audio and are copied next to the test
    assembly. They are synthesized locally by tools/make_test_fixtures - see
    tests/Assets/audio/AUDIO-FIXTURES.txt - never third-party audio.
  -->
  <ItemGroup>
    <Content Include="..\Assets\audio\*.opus;..\Assets\audio\*.ogg;..\Assets\audio\*.wav">
      <Link>Assets\audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
